# E-14 容器构建排除清单（构建上下文 = 仓库根，三个 Dockerfile 共用）
# 原则：密钥/数据/本地缓存绝不进镜像；CONTEXT 保持小而快。

# 版本控制与本工具链的工作区
.git
.github
.workbuddy
**/.workbuddy

# 密钥与本地环境（唯一豁口：compose 的 env_file 从宿主机读，不走构建上下文）
**/.env
deploy/secrets/
agt_python/.env*

# 运行数据与日志（容器里由命名卷提供）
agt_python/data/
deploy/logs/
deploy/ci-logs/
deploy/milvus/volumes/

# 本地构建产物（容器内各自重新构建）
agt_backend/target/
agt_web/node_modules/
agt_web/dist/

# 文档与测试（交付镜像不需要）
docs/
*.md
!agt_backend/src/**/*.md

# Python 本地缓存
**/__pycache__/
**/.pytest_cache/
agt_python/.venv/

# 各端 Dockerfile 自身与 compose（放进镜像无意义）
**/Dockerfile
docker-compose*.yml
