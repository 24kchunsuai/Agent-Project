# 复制为 .env 后按需修改，.env 不要提交到版本库

# ---- 应用 ----
APP_NAME=agt-python-agent
DEBUG=true
# 只服务本机 Java（企业级落地规约 S-1）：正常部署保持 127.0.0.1，外网不可达。
# 改回 0.0.0.0 等于把 agent 端暴露给网络，那时 X-Agent-Key 就是唯一防线。
HOST=127.0.0.1
PORT=8000

# ---- 服务间信任边界（企业级落地规约 S-1）----
# Java(8080) → 本服务的**全部**请求都要带 X-Agent-Key 头，值与本项全等。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 留空则本服务**拒绝启动**（fail-closed）——防"忘了配密钥就上线"。
# ⚠️ Java 侧用环境变量 AGENT_SHARED_KEY 注入**同一个值**，两侧不一致会全链路 4010。
# ⚠️ 本文件（.env）已被 .gitignore 忽略，密钥不得提交进版本库。
AGENT_SHARED_KEY=

# ---- 密钥轮换过渡窗口（E-10，平时留空）----
# 轮换期把**要被停用的那把旧密钥**填这里，本服务会同时接受新旧两把，做到不停服换密钥。
# ⚠️ 三件事：① 与 AGENT_SHARED_KEY **同值会被拒绝启动**（那不是轮换，是没换）；
#   ② 轮换结束后**清空本项**（而不是填当前值），旧密钥即刻失效；
#   ③ 能不能清了，看指标 agt_degrade_events_since_start_total{path="auth_key_legacy_used"}
#      是否连续一段时间不再增长。完整步骤：docs/密钥与配置管理.md §3。
AGENT_SHARED_KEY_PREV=

# ---- 数据目录（测试隔离）----
# ⚠️ DATA_ROOT **不要写在本文件里**：本文件由 pydantic 解析，而 DATA_ROOT 由
# app/core/paths.py 直接读**进程环境变量**（路径必须在 import app 之前定下来）。
# 需要换数据目录时用命令行环境变量，或直接起隔离服务：
#     DATA_ROOT=/tmp/agt-test python -m uvicorn app.main:app --port 8001
#     python scripts/serve_isolated.py --port 8001        # 推荐（连 Milvus 集合一起隔离）

# ---- 大模型（对话）----
# DeepSeek（OpenAI 兼容）：LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat
# 智谱 GLM：            LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4  LLM_MODEL=glm-4-plus
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ---- E-13 成本计量与配额 ----
# 价目表 JSON：键=模型名，单位 **元 / 百万 token（CNY）**（与供应商定价页同口径）。
# 未配置 = 成本恒为 0 且看板标「未配价」；配错的行收敛丢弃，不会拒绝启动。
# 例（DeepSeek 2026-09 官网价）：LLM_PRICE_JSON={"deepseek-chat": {"prompt": 2.0, "completion": 8.0}}
LLM_PRICE_JSON=
# 单用户每日 token 上限（prompt+completion，本地日）；0 = 不限。
# 超限不拒绝服务：响应挂 quota 提示（SSE 发 quota 事件）+ 落 fault_event（每用户每日一条）。
QUOTA_USER_DAILY_TOKENS=0

# ---- 向量模型（RAG 阶段启用，暂留空占位）----
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3

# ---- RAG 问答 ----
# LLM judge 评审证据充分性（领域内无答案兜底），默认开启
RAG_JUDGE_ENABLED=true

# ---- 查询改写（Query Rewrite）----
# 检索前把口语/带指代的消息改写成规范查询（词典 + LLM 两层，见 DEV_ISSUES 6.37）
RAG_REWRITE_ENABLED=true
# 关掉只留本地词典层（零 LLM 成本、确定性），适合对比实验
RAG_REWRITE_LLM_ENABLED=true
# 改写要确定性输出
RAG_REWRITE_TEMPERATURE=0.0
# 改写结果字符上限，超限视为不合格 → 回退原文检索
RAG_REWRITE_MAX_CHARS=80
# 送给改写模型的历史条数
RAG_REWRITE_HISTORY_TURNS=4

# ---- 语料治理（Corpus Governance，见 docs/specs/语料治理规约.md）----
# 治理元数据库（SQLite 单文件，只有 agt_python 读写）；留空 = data/governance/governance.db
GOV_ENABLED=true
GOV_DB_PATH=
# L1 文件指纹 / L2 切片指纹 去重门
GOV_L1_ENABLED=true
GOV_L2_ENABLED=true
# L2 命中时复用已有切片的 dense 向量（需与已有向量同 embedding 模型）
GOV_REUSE_VECTOR=true
# L3 语义查重阈值（G2 恢复确认门 / G4 巡检）
GOV_L3_THRESHOLD=0.92
# 回收站 TTL（天），超期自动彻底删除（G4）
GOV_TTL_DAYS=30
# 回填时源文件搜索根目录（相对 agt_python/，逗号分隔）
GOV_SOURCE_ROOTS=data/kb,data/kb/raw,data/kb/external

# ---- 语料治理 G2：生命周期强化（见 docs/specs/语料治理规约.md §5 状态机 / §15 落地记录）----
# 停用/启用（停用 = 物理删向量 + 备份落 data/kb/disabled/，启用从备份回灌，零 embedding）
GOV_DISABLE_ENABLED=true
# 恢复前过 L3 语义查重确认门（相似度 ≥ GOV_L3_THRESHOLD 需 confirm=true）
# 注意：这是"防恢复出第二份相似语料"的铁律 3，关掉等于放弃恢复侧查重
GOV_RESTORE_L3_GATE=true
# 彻底删除双确认（铁律 2）：只允许管理员 + confirm=true + 文档名复述一致
GOV_PURGE_REQUIRE_ADMIN=true
GOV_PURGE_REQUIRE_CONFIRM=true
# 备份随切片携带 dense 向量（float32+base64，约 11KB/片）；
# 关掉则恢复回落到"重新切片 + embedding"（慢、需联网、且 chunker 变更后边界会漂移）
GOV_BACKUP_INCLUDE_DENSE=true
# 向量对账常驻任务（扫"账本说没有、库里却有"的残留并清理；反向只告警不自愈）
GOV_RECONCILE_ENABLED=true
GOV_RECONCILE_INTERVAL_SEC=300
# 启动后先等多久再跑首轮对账（避开冷启动，别和首次上传/回填抢资源）
GOV_RECONCILE_INITIAL_DELAY_SEC=60
# 单轮处理的残留文档上限（防一轮清理过猛把 Milvus 打满）
GOV_RECONCILE_BATCH=50

# ============ G3 版本链 ============
# 版本链总开关。关闭后 /versions 与 /rollback 均不可用，
# 同名上传回到 G2 的"直接覆盖"（旧内容仍被 VERSION_REPLACE 审计记录，但没有可回滚的快照）
GOV_VERSION_CHAIN_ENABLED=true
# 同名上传时是否把旧版自动快照入回收站（role=history，文件 <doc_id>@v<n>.json）
GOV_VERSION_SNAPSHOT_ENABLED=true
# 回滚确认门：必须 confirm=true 且 confirmDocName 与文档名严格一致（与彻底删除同形）
GOV_ROLLBACK_REQUIRE_CONFIRM=true
# 回滚只允许管理员：回滚换掉的是**在库的可检索内容**，影响全体使用者，属治理动作
GOV_ROLLBACK_REQUIRE_ADMIN=true
# 每个文档保留的历史快照份数上限（超出的最老快照自动清理，防"每天覆盖"无限堆积）
GOV_VERSION_KEEP=10

# ============ G4 巡检工单化 ============
# 巡检总开关：关闭后定时巡检与 /inspection/scan 都不再产生新工单（已有工单仍可处理）
GOV_INSPECTION_ENABLED=true
GOV_INSPECTION_INTERVAL_SEC=3600
GOV_INSPECTION_INITIAL_DELAY_SEC=120
# STALE 判据：updated_at 早于"现在 - N 天"的 ACTIVE 文档
GOV_STALE_DAYS=180
# LOW_QUALITY 判据：存在 char_len 小于此值的切片（这类切片几乎不含语义，只会稀释检索）
# 取值必须落在切片器的 min_section(40) 与 min_chunk(100) 之间，否则对真实上传永不命中：
# <40 的段落已被切片器直接丢弃、<100 的段落会先尝试合并，故取 10 时该检查等于空转。
# 50 才能检出"合并后仍偏短"的段落（2026-09-18 由 10 调整为 50，见规约 §17.3）
GOV_LOW_QUALITY_CHARS=50
# 单轮巡检处理的文档上限（L3 巡检要逐篇取样向量做检索，防一轮扫太多拖垮服务）
GOV_INSPECTION_DOCS=300
# L3 巡检每篇取样的切片数（越多越准、越慢）
GOV_INSPECTION_SAMPLES=3

# ============ G4 TTL 清理 ============
# 回收站超期自动彻底删除（天）：与 GOV_TTL_DAYS 配对，只作用于 RECYCLED，停用区无 TTL
GOV_TTL_ENABLED=true
GOV_TTL_INTERVAL_SEC=3600
GOV_TTL_INITIAL_DELAY_SEC=180
# 单轮彻底删除的文档上限（防一轮清理过猛把 Milvus 打满）
GOV_TTL_BATCH=20

# ---------- 业务执行引擎（docs/specs/业务操作全能力规约.md §12）----------
# Plan-and-Execute 总开关（false=全部走 REACT）
AGENT_PLANNING_ENABLED=true
# 计划步数上限
AGENT_PLANNING_MAX_PLAN_STEPS=6
# 复杂度路由：rule_only / llm_only / rule_llm_fallback
AGENT_ROUTER_MODE=rule_llm_fallback
# 多智能体总开关（P1 起默认打开；关闭则 delegate_subagent 不注册）
AGENT_SUBAGENT_ENABLED=true
# 会话级委派上限
AGENT_SUBAGENT_MAX_CALLS_PER_SESSION=10
# 子智能体单实例并行度
AGENT_SUBAGENT_PARALLELISM=4
# 循环指纹熔断：同工具+同参数第 N 次拒绝执行（第 N-1 次提醒），0 窗口=会话级
AGENT_LOOP_SAME_CALL_MAX=3
# 单工具连续失败熔断阈值（会话级连续计数，成功清零）
AGENT_TOOL_FAIL_MAX=3
# 工具执行 wait_for 上限（秒）；media_upload 自动覆盖为 JS DSTU_UPLOAD_TIMEOUT
AGENT_TOOL_TIMEOUT=15
# 指纹滚动窗口大小，0=会话级全窗口（跨消息生效）
AGENT_FINGERPRINT_WINDOW=0
# LLM failover 备用 provider（OpenAI 兼容；三项任一为空=无备用，单主运行）
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
# provider 持续故障后的冷却期（秒），冷却期内跳过、到期半开探测
LLM_COOLDOWN_SECONDS=300
# 业务查询重试（仅 GET 幂等请求；网络错误/5xx 时生效，写操作绝不自动重试）
JSDSTU_QUERY_RETRY=1
JSDSTU_RETRY_BACKOFF=0.5
# 降级计数（容错规约 §8 铁律 1：降级必须计数）
FAULT_COUNTERS_ENABLED=true
# 数据中台埋点（业务规约 §10；关闭则 SQLite 四表不写，overview 只出计数器）
TELEMETRY_ENABLED=true
TELEMETRY_FLUSH_INTERVAL=5
TELEMETRY_DB_PATH=

# ---- 前端运行时报错上报（docs/specs/企业级落地规约.md E-12，判据 C3）----
# 浏览器侧三处收口（Vue errorHandler / window.onerror / unhandledrejection）
# 上报到 POST /v1/ops/client-error，落在 observability.db 的 client_error 表。
# 看板入口：前端「数据中台 · 观测 → 前端错误」页。
# 总开关；false 时接口仍返回 2000 但 data.stored=false + reason 明确说不入库
CLIENT_ERROR_ENABLED=true
# 采样率 0~1：1.0=全收。存在的意义是"前端循环报错把接口当洪水灌"时降量；
# 配错值（负数/大于1/非数字）会**收敛**到 [0,1] 而不是拒绝启动
CLIENT_ERROR_SAMPLE_RATE=1.0
# 合并窗口（秒）：同一错误在该窗口内**只占一行**、count 累加（防前端报错风暴刷爆表）
# 口径是固定桶 floor(now/window)*window；跨桶边界（如 10:00:59 与 10:01:01）会各占一行
CLIENT_ERROR_DEDUP_SECONDS=60
# 入库前的截断长度（字符）；不设上限时完整 stack 常有数 KB，逐条存会让表暴涨
CLIENT_ERROR_MAX_MESSAGE=500
CLIENT_ERROR_MAX_STACK=2000

# ---- S-8 PII 脱敏（企业级落地规约 S-8，与 E-6 同源）----
# 手机号/身份证/邮箱在日志/埋点/展示出口统一替换为 ***；默认开启，关闭仅限受控调试
PII_REDACT_ENABLED=true

# ---- 会话记忆（docs/specs/会话记忆规约.md §5.3，M-1/M-2）----
# 存储介质：sqlite(持久化，默认) / memory(纯内存，重启即失，仅调试用)
# sqlite 不可用时自动退回 memory 并计 memory_sqlite_degraded，主链路不中断
MEMORY_STORE=sqlite
# 会话消息保留天数（清理走产品内定时任务，不手工删文件）
MEMORY_TTL_DAYS=30
# TTL 清理周期（秒，默认每天一次；仅 memory_store=sqlite 时生效）
MEMORY_TTL_INTERVAL_SECONDS=86400
# 会话数上限（内存缓存上限，超出淘汰最久未访问并在淘汰前落盘）
MEMORY_MAX_SESSIONS=500
# 增量落盘三条件之二：累计轮次阈值 / 最长间隔（秒）
MEMORY_SYNC_ROUND_THRESHOLD=10
MEMORY_SYNC_INTERVAL_SECONDS=60
# 单次注入历史的 token 预算（超预算才触发双锚点裁剪+中间摘要）
MEMORY_TOKEN_BUDGET=3000
# 双锚点：头部轮数（会话开头的身份/任务/约束） + 尾部轮数（当前话题）
MEMORY_HEAD_TURNS=2
MEMORY_TAIL_TURNS=6
# 触发中间段摘要的最小轮数（防为一点内容白付一次 LLM 调用）
MEMORY_SUMMARY_MIN_TURNS=8
# ---- M-3 相关性过滤（docs/specs/会话记忆规约.md §6 M-3）----
# 总开关；关闭后退回 M-2 行为（历史不过滤，全量交给裁剪器）
MEMORY_FILTER_ENABLED=true
# 少于该轮数不触发过滤（短会话过滤无收益，白付 embedding 成本）
MEMORY_FILTER_MIN_TURNS=8
# 中间候选最多保留轮数（锚点轮不占此额）；topK 是上限不是保底，min_score 仍可淘汰
MEMORY_FILTER_TOP_K=6
# 相似度权重（关键词项权重 = 1 - 此值）。注意：关键词项未接中文分词前，打分按纯相似度（权重 1.0）计
MEMORY_FILTER_SIMILARITY_WEIGHT=0.9
# 低于此相似度直接归零（防低分堆叠挤占 topK）
MEMORY_FILTER_MIN_SIMILARITY=0.35
# 综合分阈值，不达标不保留
MEMORY_FILTER_MIN_SCORE=0.2
# ---- M-5 用户画像（docs/specs/会话记忆规约.md §6 M-5）----
# 增强能力不是主链路：抽取失败静默降级；false=不抽取也不注入（规约硬要求：必须可人工关闭）
PROFILE_ENABLED=true
# 同一用户两次抽取最小间隔（秒，控 LLM 成本）
PROFILE_EXTRACT_INTERVAL_SECONDS=90
# 问题短于该字数不抽取（"在吗"无信息量）
PROFILE_MIN_MESSAGE_CHARS=6

# ---- E-6 结构化日志（docs/日志规范.md）----
# 日志目录：留空 = <仓库根>/deploy/logs；数据目录被隔离（测试/脚本）时自动改到隔离目录下
LOG_DIR=
# 服务名，进日志的 service 字段（两侧各一个固定值：agt_python / agt_backend）
LOG_SERVICE=agt_python
# 结构化文件名：留空 = <PORT>-<LOG_SERVICE>.jsonl
LOG_JSON_FILE=
# 单文件上限 50MB、保留 10 份（与 Java 侧 logback 对齐；改要两侧一起改）
LOG_MAX_BYTES=52428800
LOG_BACKUP_COUNT=10
# 级别：留空 = DEBUG（DEBUG=true 时）或 INFO
LOG_LEVEL=
