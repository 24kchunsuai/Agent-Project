<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 与 asdtn2604-teacher-03/drone 保持一致，复用本地已缓存的依赖 -->
        <version>3.3.3</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <!-- Generated by https://start.springboot.io -->
    <!-- 优质的 spring/boot/data/security/cloud 框架中文文档尽在 => https://springdoc.cn -->
    <groupId>cn.tedu</groupId>
    <artifactId>agt_backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>agt_backend</name>
    <description>drone-agent 业务后端：面向 Vue 提供接口，向内调用 Python 智能体服务</description>

    <properties>
        <java.version>17</java.version>
        <lombok.version>1.18.30</lombok.version>
        <knife4j.version>4.4.0</knife4j.version>

        <!-- ================================================================
             嵌入式 Tomcat 版本覆盖（E-11 依赖漏洞扫描的第一个真实产出）
             ================================================================
             Spring Boot 3.3.3 托管 tomcat 10.1.28，实测（OSV，2026-09-24）：
               tomcat-embed-core 10.1.28 → 33 条漏洞，其中 **7 条 CRITICAL**
                                            （DIGEST/FORM 认证绕过、HTTP/2 头未校验、
                                             SecurityConstraints 未生效等）

             ⚠️ 不要靠"顺手升 Spring Boot 小版本"来修：实测 3.3.13（该线最新）
                托管的是 10.1.42，**仍有 6 条 CRITICAL**。必须显式覆盖 tomcat。

             选 10.1.60 的依据（同一 10.1 线，实测漏洞清零）：
               10.1.28 → CRITICAL 7 / HIGH 14
               10.1.42 → CRITICAL 6 / HIGH 11
               10.1.54 → CRITICAL 6 / HIGH  3
               10.1.57 → CRITICAL 3 / HIGH  0
               **10.1.60 → 0 条**（残留 Critical/High 全清）
             同 minor 线内 Tomcat 保持向后兼容，故风险低于跨线升级。

             复核方式：bash scripts/ci.sh deps（或 python scripts/scan_deps.py）。
             若将来再出现 Critical，处置流程见 docs/依赖与漏洞处置.md。
        -->
        <tomcat.version>10.1.60</tomcat.version>
    </properties>

    <dependencies>
        <!-- 接口文档，版本与 drone 项目一致 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
            <version>${knife4j.version}</version>
        </dependency>

        <!-- 对外提供 REST 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- ===================================================================
             产物名固定为 target/agt_backend.jar（**不带版本号**）。
             理由（企业级落地规约 E-2「统一 jar 命名」）：
               这个 jar 是**部署契约**，被 deploy/start-backend.cmd 引用，
               而该脚本又被计划任务 drone-agent-8080-backend 引用。
               若产物名带版本（Maven 默认的 agt_backend-0.0.1-SNAPSHOT.jar），
               就会出现"产物名里的 0.0.1-SNAPSHOT 与仓库根 VERSION=1.0.0 不一致"
               这种典型的运维困惑，且每次升版本都要改多处引用。
             版本从哪里看：
               运行时 GET :8080/v1/version（读取 src/main/resources/build-info.properties，
               由 scripts/stamp_version.py 依据仓库根 VERSION 生成）。
             Maven 坐标（groupId:artifactId:version）不参与部署，刻意保持不变，
             避免 IDE 重新索引与本地仓库缓存失效。
             =================================================================== -->
        <finalName>agt_backend</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
